# Yerelde .env olarak kopyala ya da GitHub Secrets'a ekle. Gerçek değerleri asla commit etme.

# Wix: manage.wix.com/account/api-keys adresinden "Manage Calendars" izniyle oluşturulan API anahtarı
WIX_API_KEY=
WIX_SITE_ID=21200a6c-2c33-404e-9b19-6b6a7756c9f5
# "npm run setup:wix" komutu oluşturur (her kaynak için bir blok takvimi)
WIX_BLOCK_SCHEDULE_LINKJOURNAL=
WIX_BLOCK_SCHEDULE_BOKADIREKT=

# Link Journal: API erişimi gelince doldurulacak
LINKJOURNAL_API_URL=
LINKJOURNAL_API_KEY=

# Boka Direkt: API (verirlerse) ya da iCal linki (sadece okuma)
BOKADIREKT_API_URL=
BOKADIREKT_API_KEY=
# Personel başına iCal linki (Inställningar → Användare → Platsuppgifter → ICal synkronisering)
BOKADIREKT_ICS_VOLKAN=
BOKADIREKT_ICS_DAVUT=
BOKADIREKT_ICS_URL=
# iCal linki tek bir kişiye aitse: config/staff.json'daki personel "key" değeri
BOKADIREKT_ICS_STAFF=

# Kaç gün ileriye kadar senkronize edilecek
SYNC_DAYS_AHEAD=90
# Güvenlik sınırı: bir çalışma bundan fazla blok iptal etmek isterse durur
SYNC_MAX_CANCELS=60
